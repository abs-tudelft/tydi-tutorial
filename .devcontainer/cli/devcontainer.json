{
  "name": "Tydi-Tools (CLI only)",

  // Command-line only image, without the XFCE desktop and noVNC server.
  // GUI apps (Surfer, ...) may still work when launched from the terminal.
  "image": "hdltypetech/tydi-tools:cli-latest",

  // Mounting the workspace directory to /root/workspace in the container
  "workspaceMount": "source=${localWorkspaceFolder},target=/root/workspace,type=bind",
  "workspaceFolder": "/root/workspace",

  // A named volume for the Scala dependency cache, shared with the VNC flavour.
  // Without it, every rebuild re-downloads roughly 700 MB for tinytydi/hdl and
  // the sample circuits.
  "mounts": [
    "source=tinytydi-coursier,target=/var/cache/coursier,type=volume"
  ],

  // Checks out the TinyTydi submodule and builds the stimulus bundles its
  // Chisel tests read. Idempotent, and never fails the container.
  "postCreateCommand": "bash .devcontainer/bootstrap.sh",

  // Development extensions that are useful for working with Tydi-tools
  "customizations": {
    "vscode": {
      "extensions": [
        "scalameta.metals",         // Scala & Chisel support (Metals)
        "ms-python.python",         // Python extension
        "ms-python.vscode-pylance", // Smart code completion for Python
        "tamasfe.even-better-toml"  // Useful for the Tydi-lang config files
      ]
    }
  }

  // NOTE: do not set "overrideCommand": false here. This image's CMD is plain
  // `bash`, which exits immediately without a TTY, so the container would stop
  // right after starting ("container ... is not running"). Leaving it at its
  // default (true) makes VS Code supply its own keep-alive command.
}
